   "report": 1,
   "export": 1
  },
  {
   "role": "FCM Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 0,
   "cancel": 0,
   "report": 1,
   "export": 1
  },
  {
   "role": "FCM User",
   "read": 1,
   "write": 1,
   "create": 1,
   "report": 1
  }
 ],
