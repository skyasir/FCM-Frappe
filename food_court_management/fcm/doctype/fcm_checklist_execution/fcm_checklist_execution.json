{
 "doctype": "DocType",
 "name": "FCM Checklist Execution",
 "module": "Fcm",
 "custom": 0,
 "istable": 0,
 "editable_grid": 0,
 "track_changes": 1,
 "is_submittable": 0,
 "engine": "InnoDB",
 "fields": [
  {
   "fieldname": "naming_series",
   "label": "Series",
   "fieldtype": "Select",
   "options": "FCM-CKE-.YYYY.-",
   "default": "FCM-CKE-.YYYY.-"
  },
  {
   "fieldname": "checklist_template",
   "label": "Checklist Template",
   "fieldtype": "Link",
   "options": "FCM Checklist Template",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "task_name",
   "label": "Task",
   "fieldtype": "Data",
   "read_only": 1,
   "fetch_from": "checklist_template.task_name"
  },
  {
   "fieldname": "vendor",
   "label": "Vendor",
   "fieldtype": "Link",
   "options": "Supplier",
   "fetch_from": "checklist_template.default_vendor"
  },
  {
   "fieldname": "supervisor",
   "label": "Supervisor",
   "fieldtype": "Link",
   "options": "Employee",
   "fetch_from": "checklist_template.default_supervisor"
  },
  {
   "fieldname": "due_date",
   "label": "Due Date",
   "fieldtype": "Date",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "completion_date",
   "label": "Completion Date",
   "fieldtype": "Date",
   "in_list_view": 1
  },
  {
   "fieldname": "photo",
   "label": "Photo",
   "fieldtype": "Attach Image"
  },
  {
   "fieldname": "status",
   "label": "Status",
   "fieldtype": "Select",
   "options": "Pending\nCompleted\nVerified\nOverdue\nRejected",
   "default": "Pending",
   "in_list_view": 1
  },
  {
   "fieldname": "supervisor_verified",
   "label": "Supervisor Verified",
   "fieldtype": "Check",
   "default": 0
  },
  {
   "fieldname": "vendor_bill_approved",
   "label": "Vendor Bill Approved",
   "fieldtype": "Check",
   "default": 0
  },
  {
   "fieldname": "remarks",
   "label": "Remarks",
   "fieldtype": "Small Text"
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 0,
   "cancel": 0,
   "report": 1,
   "export": 1
  },
  {
   "role": "FCM Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 0,
   "cancel": 0,
   "report": 1,
   "export": 1
  },
  {
   "role": "FCM User",
   "read": 1,
   "write": 1,
   "create": 1,
   "report": 1
  }
 ],
 "autoname": "naming_series:"
}