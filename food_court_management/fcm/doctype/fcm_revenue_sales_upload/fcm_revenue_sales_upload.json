{
 "doctype": "DocType",
 "name": "FCM Revenue Sales Upload",
 "module": "Fcm",
 "custom": 0,
 "istable": 0,
 "editable_grid": 0,
 "track_changes": 1,
 "is_submittable": 0,
 "engine": "InnoDB",
 "fields": [
  {
   "fieldname": "naming_series",
   "label": "Series",
   "fieldtype": "Select",
   "options": "FCM-RS-.YYYY.-",
   "default": "FCM-RS-.YYYY.-"
  },
  {
   "fieldname": "lease_contract",
   "label": "Lease Contract",
   "fieldtype": "Link",
   "options": "FCM Lease Contract",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "month",
   "label": "Month",
   "fieldtype": "Select",
   "options": "January\nFebruary\nMarch\nApril\nMay\nJune\nJuly\nAugust\nSeptember\nOctober\nNovember\nDecember",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "year",
   "label": "Year",
   "fieldtype": "Int",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "upload_method",
   "label": "Upload Method",
   "fieldtype": "Select",
   "options": "API\nCSV Upload\nExcel Upload\nManual Entry",
   "default": "Manual Entry"
  },
  {
   "fieldname": "gross_sales",
   "label": "Gross Sales",
   "fieldtype": "Currency",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "revenue_share_percent",
   "label": "Revenue Share %",
   "fieldtype": "Percent",
   "fetch_from": "lease_contract.revenue_share_percent"
  },
  {
   "fieldname": "revenue_share_amount",
   "label": "Revenue Share Amount",
   "fieldtype": "Currency",
   "read_only": 1
  },
  {
   "fieldname": "minimum_guarantee",
   "label": "Minimum Guarantee (MG)",
   "fieldtype": "Currency",
   "fetch_from": "lease_contract.minimum_guarantee"
  },
  {
   "fieldname": "net_invoice_amount",
   "label": "Net Invoice Amount (Higher of RS or MG)",
   "fieldtype": "Currency",
   "read_only": 1
  },
  {
   "fieldname": "is_duplicate",
   "label": "Duplicate Check Flag",
   "fieldtype": "Check",
   "default": 0,
   "read_only": 1
  },
  {
   "fieldname": "is_validated",
   "label": "Validated",
   "fieldtype": "Check",
   "default": 0
  },
  {
   "fieldname": "sales_invoice_reference",
   "label": "Sales Invoice Reference",
   "fieldtype": "Link",
   "options": "Sales Invoice",
   "read_only": 1
  },
  {
   "fieldname": "source_file",
   "label": "Source File (CSV/Excel)",
   "fieldtype": "Attach"
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 0,
   "cancel": 0,
   "report": 1,
   "export": 1
  },
  {
   "role": "FCM Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 0,
   "cancel": 0,
   "report": 1,
   "export": 1
  },
  {
   "role": "FCM User",
   "read": 1,
   "write": 1,
   "create": 1,
   "report": 1
  }
 ],
 "autoname": "naming_series:"
}