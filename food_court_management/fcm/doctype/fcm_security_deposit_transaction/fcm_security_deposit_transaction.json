   "options": "Receipt\nAdjustment\nRefund\nForfeiture",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "transaction_date",
   "label": "Date",
   "fieldtype": "Date",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "amount",
   "label": "Amount",
   "fieldtype": "Currency",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "reference_payment_entry",
   "label": "Reference Payment Entry",
   "fieldtype": "Link",
   "options": "Payment Entry"
  },
  {
   "fieldname": "remarks",
   "label": "Remarks",
